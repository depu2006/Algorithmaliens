# Google Apps Script Web App URLs for Google Sheets Submissions (optional)
# Replace these placeholder URLs with your actual Google Apps Script web app deployment URLs.
VITE_CONTACT_FORM_URL=https://script.google.com/macros/s/YOUR_CONTACT_APPS_SCRIPT_ID/exec
VITE_BOOKCALL_FORM_URL=https://script.google.com/macros/s/YOUR_BOOKCALL_APPS_SCRIPT_ID/exec

# Example environment variables (DO NOT COMMIT real secrets)
# Copy this to .env and fill with your values in development.

# JSON Web Token secret used to sign admin tokens
JWT_SECRET=replace_with_a_long_random_string

# Default admin password used only at first-run if users table is empty
# DO NOT put production passwords here; use secrets manager in production
ADMIN_DEFAULT_PASSWORD=change_this_before_first_run

# Only enable for local development to return the reset token in the API response
DEV_SHOW_TOKEN=false

# SMTP configuration for sending password reset emails (optional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Frontend URL used in reset links sent via email
FRONTEND_URL=http://localhost:5173

# Contact email fallback used by mailer when user email is not present
ADMIN_CONTACT_EMAIL=
